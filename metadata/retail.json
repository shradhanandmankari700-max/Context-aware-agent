{
  "metadata": {
    "schemaVersion": 1,
    "appId": "retail",
    "name": "Retail Operations",
    "description": "Retail inventory, sales orders and replenishment operations.",
    "referenceDate": "2026-10-07",
    "roles": ["admin", "staff", "viewer"],
    "datasets": [
      {
        "name": "products",
        "label": "Products",
        "description": "Product catalog with category, price, stock and reorder threshold.",
        "table": "products",
        "fields": [
          { "name": "product_id", "label": "Product ID", "type": "string", "roles": ["key"] },
          { "name": "product_name", "label": "Product", "type": "string", "roles": ["label"], "synonyms": ["item", "merchandise"] },
          { "name": "category", "label": "Category", "type": "string", "roles": ["dimension"], "enumValues": ["Electronics", "Home", "Apparel", "Grocery", "Beauty"], "synonyms": ["department", "product type"] },
          { "name": "unit_price", "label": "Unit price", "type": "number", "format": "currency", "unit": "INR", "roles": ["metric"], "synonyms": ["price", "cost"] },
          { "name": "stock", "label": "Stock on hand", "type": "number", "format": "integer", "roles": ["metric"], "synonyms": ["inventory", "quantity available", "units left"] },
          { "name": "reorder_level", "label": "Reorder level", "type": "number", "format": "integer", "roles": ["metric"], "synonyms": ["restock threshold", "minimum stock"] }
        ]
      },
      {
        "name": "sales_orders",
        "label": "Sales orders",
        "description": "Customer orders with quantities, totals, dates and fulfillment status.",
        "table": "sales_orders",
        "timeField": "order_date",
        "fields": [
          { "name": "order_id", "label": "Order ID", "type": "string", "roles": ["key"] },
          { "name": "product_id", "label": "Product ID", "type": "string", "roles": ["dimension"] },
          { "name": "customer", "label": "Customer", "type": "string", "roles": ["label"] },
          { "name": "order_date", "label": "Order date", "type": "date", "roles": ["time"], "synonyms": ["purchase date", "sale date"] },
          { "name": "quantity", "label": "Quantity", "type": "number", "format": "integer", "roles": ["metric"], "synonyms": ["units sold"] },
          { "name": "total", "label": "Order total", "type": "number", "format": "currency", "unit": "INR", "roles": ["metric"], "synonyms": ["sales", "revenue", "amount"] },
          { "name": "status", "label": "Fulfillment status", "type": "string", "roles": ["dimension"], "enumValues": ["Pending", "Packed", "Shipped", "Delivered", "Cancelled"] }
        ],
        "relations": [{ "field": "product_id", "toDataset": "products", "toField": "product_id" }]
      }
    ],
    "pages": [
      {
        "id": "dashboard",
        "name": "Retail dashboard",
        "route": "/dashboard",
        "parent": null,
        "description": "Overview of retail sales and order activity.",
        "widgets": [
          { "id": "totalSales", "name": "Total sales", "type": "kpi", "dataset": "sales_orders", "kpi": { "field": "total", "agg": "sum", "where": [] } },
          { "id": "salesByDate", "name": "Sales over time", "type": "chart", "dataset": "sales_orders", "description": "Daily sales totals by order date.", "chart": { "kind": "line", "x": { "field": "order_date", "grain": "day" }, "y": { "field": "total", "agg": "sum" } } }
        ],
        "filters": []
      },
      {
        "id": "inventory",
        "name": "Product inventory",
        "route": "/inventory",
        "parent": null,
        "description": "Product stock levels, prices, categories and restocking thresholds.",
        "widgets": [
          { "id": "productCatalog", "name": "Product catalog", "type": "table", "dataset": "products", "description": "Browse merchandise, stock on hand and reorder levels.", "columns": [{ "field": "product_id" }, { "field": "product_name" }, { "field": "category" }, { "field": "unit_price" }, { "field": "stock" }, { "field": "reorder_level" }], "sortable": ["product_name", "unit_price", "stock"], "defaultSort": { "field": "product_name", "direction": "asc" } }
        ],
        "filters": [
          { "id": "productCategory", "label": "Product category", "type": "enum", "field": "category", "synonyms": ["department"], "options": [{ "value": "Electronics", "label": "Electronics" }, { "value": "Home", "label": "Home" }, { "value": "Apparel", "label": "Apparel" }, { "value": "Grocery", "label": "Grocery" }, { "value": "Beauty", "label": "Beauty" }] },
          { "id": "stockLevel", "label": "Stock level", "type": "number", "field": "stock", "description": "Filter by the quantity currently available.", "synonyms": ["low inventory", "units left"], "operators": ["lt", "lte", "gt", "gte", "between"] }
        ]
      },
      {
        "id": "orders",
        "name": "Sales orders",
        "route": "/orders",
        "parent": null,
        "description": "Customer sales orders, totals and fulfillment progress.",
        "widgets": [
          { "id": "orderList", "name": "Order list", "type": "table", "dataset": "sales_orders", "columns": [{ "field": "order_id" }, { "field": "product_id" }, { "field": "customer" }, { "field": "order_date" }, { "field": "quantity" }, { "field": "total" }, { "field": "status" }], "sortable": ["order_date", "quantity", "total"], "defaultSort": { "field": "order_date", "direction": "desc" } }
        ],
        "filters": [
          { "id": "orderStatus", "label": "Fulfillment status", "type": "enum", "field": "status", "synonyms": ["delivery status"], "options": [{ "value": "Pending", "label": "Pending" }, { "value": "Packed", "label": "Packed" }, { "value": "Shipped", "label": "Shipped" }, { "value": "Delivered", "label": "Delivered" }, { "value": "Cancelled", "label": "Cancelled" }] },
          { "id": "orderDate", "label": "Order date", "type": "dateRange", "field": "order_date", "synonyms": ["sales date", "purchase date"] }
        ]
      }
    ],
    "actions": []
  },
