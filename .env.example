# Copy to .env (never commit .env). Each teammate uses their OWN keys.
DATABASE_URL=postgres://cab:cab@localhost:5432/cab
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-in-dev

# Demo clock: ALL "today/tomorrow/this month" resolve against this, so data + demo are deterministic.
DEMO_NOW=2026-10-07

# LLM (provider-agnostic wrapper in backend/src/llm). Use the single Nvidia API key for this project.
LLM_PROVIDER=nvidia            # nvidia | gemini | groq | openrouter | ollama
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEYS_EXTRA=            # optional spare Nvidia keys, rotated on rate-limit
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_CACHE=on                   # on | off. 'off' for the live demo if internet is good. Cache hits are flagged in traces.

# Embeddings (default local, no quota)
EMBEDDING_PROVIDER=local       # local | gemini
EMBEDDING_DIM=384

# UI control: api = real frontend over SSE | simulated = in-memory (eval/CI) | playwright = fallback
UI_ADAPTER=api

# Dev-only seeded users created by database/schema.sql.
# Password for every seeded account: demo123
# admin@hospital.demo | staff@hospital.demo | viewer@hospital.demo
# admin@hotel.demo | staff@hotel.demo | viewer@hotel.demo
